# PISN mass function + LVK-style normalized q^beta pairing, WITH mpisndot
# free (redshift evolution of the PISN mass scale turned ON).  Copy of
# real_dat_noevo_qpair_r.prior with only the pivot-evolution lines changed
# ("noevo" kept in the name for family traceability):
#   mpisndot = 0                      ->  mpisndot = Uniform(low=-2, high=8)
#   mpisn_ref low bound 20.0          ->  23.5
# Both values match gwtc5_fullcosmo_evo_pivot_fpeak_w15.prior; the tightened
# mpisn_ref bounds keep the derived mpisn = mpisn_ref - mpisndot*zpivot/(1+zpivot)
# inside [20, 50] for every mpisndot in [-2, 8] at zpivot = 0.75 (see
# notes/2026-08-09-pivot-reparam.md).  Everything else (cosmology fixed,
# q^beta pairing prior, height-anchored tail) identical to the qpair baseline.
h = 0.674
Om = 0.315
w = -1
a = TruncatedNormal(2.35, 2, low=-6.0, high=6.35)
b = TruncatedNormal(1.9, 2, low=-6.0, high=5.9)
c = TruncatedNormal(4, 2, low=0, high=8)
mpisn_ref = TruncatedNormal(35.0, 5.0, low=23.5, high=49.1)
dmbhmax = TruncatedNormal(3.0, 2.0, low=0.5, high=7.0)
sigma = TruncatedNormal(0.1, .1, low=0.05)
beta = Uniform(-4.0, 7.0)
lam = TruncatedNormal(2.7, 2.0, low=-1.3, high=6.7)
dkappa = TruncatedNormal(2.9, 2.0, low=1, high=6.9)
zp = TruncatedNormal(1.9, 1, low=0, high=3.9)
mpisndot = Uniform(low=-2, high=8)
zmax = 3.0
mbh_min = 3
delta_m = 1.6
mp_low = TruncatedNormal(9.0, 2.0, low=5.0, high=15.0)
msigma_low = TruncatedNormal(3.0, 2.0, low=0.5, high=5.0)
log_fpeak = Uniform(np.log(1e-3), np.log(4))
# Height-anchored tail (run with tail_anchor = ref_z or per_z): r is the
# tail/continuum height ratio at the join, capped at r_max = 1; fpl becomes a
# derived parameter.  See notes/2026-08-29-height-capped-tail-parametrization.md.
log_r = Uniform(np.log(1e-2), 0.0)
zpivot = 0.75
